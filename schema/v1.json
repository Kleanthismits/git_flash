{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kleanthismits/git_flash/blob/main/schema/v1.json",
  "title": "gitflash --json output, schema version 1",
  "description": "Every gitflash command run with --json prints exactly one object in this envelope. `ok` is true for the statuses done, planned, noop and cancelled. Fields may be added in later releases of version 1; existing fields keep their meaning.",
  "type": "object",
  "required": [
    "schema",
    "command",
    "ok",
    "status",
    "dry_run"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "command": {
      "enum": [
        "branches",
        "checkout",
        "delete",
        "reset",
        "undo",
        "snapshots",
        "snapshot",
        "gc",
        "hook install",
        "hook status",
        "worktree list",
        "worktree add",
        "worktree remove",
        "worktree prune",
        "worktree lock",
        "worktree unlock",
        "worktree move",
        "clean",
        "worktree clean"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "description": "done: the change was made. planned: --dry-run, nothing changed. noop: nothing to do. cancelled: the user declined. failed: git refused part of the change. confirmation_required: re-run with --yes after reviewing `plan`. error: invalid input or environment.",
      "enum": [
        "done",
        "planned",
        "noop",
        "cancelled",
        "failed",
        "confirmation_required",
        "error"
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "plan": {
      "type": "object",
      "description": "The change that will be, would be or was made."
    },
    "result": {
      "type": "object",
      "description": "What happened, including what is needed to revert it."
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "undo": {
      "type": "object",
      "description": "The snapshot saved before the change. Run `command` to revert it.",
      "required": [
        "snapshot",
        "command"
      ],
      "properties": {
        "snapshot": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "done",
              "planned",
              "noop",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "properties": {
          "ok": {
            "const": false
          }
        },
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmation_required"
          }
        }
      },
      "then": {
        "required": [
          "plan"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "branches"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/branches_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "checkout"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/checkout_plan"
          },
          "result": {
            "$ref": "#/$defs/checkout_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "delete"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/delete_plan"
          },
          "result": {
            "$ref": "#/$defs/delete_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "reset"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/reset_plan"
          },
          "result": {
            "$ref": "#/$defs/reset_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "undo"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/undo_plan"
          },
          "result": {
            "$ref": "#/$defs/undo_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "snapshots"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/snapshots_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "snapshot"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/snapshot_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "gc"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/gc_plan"
          },
          "result": {
            "$ref": "#/$defs/gc_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hook install"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/hook_install"
          },
          "result": {
            "$ref": "#/$defs/hook_install"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "hook status"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/hook_status"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "worktree list"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/worktree_list_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "worktree add"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/worktree_add_plan"
          },
          "result": {
            "$ref": "#/$defs/worktree_add_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "worktree remove"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/worktree_remove_plan"
          },
          "result": {
            "$ref": "#/$defs/worktree_remove_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "worktree prune"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/worktree_prune_plan"
          },
          "result": {
            "$ref": "#/$defs/worktree_prune_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "worktree lock"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/worktree_lock_plan"
          },
          "result": {
            "$ref": "#/$defs/worktree_lock_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "worktree unlock"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/worktree_unlock_plan"
          },
          "result": {
            "$ref": "#/$defs/worktree_unlock_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "worktree move"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/worktree_move_plan"
          },
          "result": {
            "$ref": "#/$defs/worktree_move_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "clean"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/clean_plan"
          },
          "result": {
            "$ref": "#/$defs/delete_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "worktree clean"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "$ref": "#/$defs/worktree_clean_plan"
          },
          "result": {
            "$ref": "#/$defs/worktree_remove_result"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{4,64}$"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "exit_code"
      ],
      "properties": {
        "code": {
          "description": "Stable identifier to branch on; the message is for humans.",
          "enum": [
            "not_a_repository",
            "input_required",
            "invalid_usage",
            "invalid_options",
            "unknown_branch",
            "unknown_commit",
            "protected_branch",
            "confirmation_required",
            "git_failed",
            "failed",
            "unknown_snapshot",
            "wrong_worktree",
            "invalid_settings",
            "invalid_config",
            "unknown_worktree",
            "protected_worktree"
          ]
        },
        "message": {
          "type": "string"
        },
        "exit_code": {
          "enum": [
            1,
            2
          ]
        }
      }
    },
    "branch": {
      "type": "object",
      "required": [
        "name",
        "sha",
        "current",
        "default",
        "upstream",
        "upstream_gone",
        "ahead",
        "behind",
        "merged",
        "last_commit_at",
        "last_commit_author",
        "last_commit_subject"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha": {
          "$ref": "#/$defs/sha"
        },
        "current": {
          "type": "boolean"
        },
        "default": {
          "type": "boolean",
          "description": "The branch origin/HEAD points to, else main or master."
        },
        "upstream": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream_gone": {
          "type": "boolean",
          "description": "The upstream branch was deleted on the remote."
        },
        "ahead": {
          "type": "integer",
          "minimum": 0
        },
        "behind": {
          "type": "integer",
          "minimum": 0
        },
        "merged": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Merged into the default branch; null when there is no default branch."
        },
        "last_commit_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_commit_author": {
          "type": "string"
        },
        "last_commit_subject": {
          "type": "string"
        },
        "owner": {
          "enum": [
            "agent",
            "human",
            null
          ],
          "description": "Who created the branch; null when unmarked (treated as human)."
        }
      }
    },
    "branches_result": {
      "type": "object",
      "required": [
        "default_branch",
        "branches"
      ],
      "properties": {
        "default_branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch"
          }
        }
      }
    },
    "checkout_plan": {
      "type": "object",
      "required": [
        "branch"
      ],
      "properties": {
        "branch": {
          "type": "string"
        }
      }
    },
    "checkout_result": {
      "type": "object",
      "required": [
        "branch",
        "previous_branch"
      ],
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_branch": {
          "type": [
            "string",
            "null"
          ],
          "description": "Check this out to go back; null on a detached HEAD."
        }
      }
    },
    "delete_plan": {
      "type": "object",
      "required": [
        "branches",
        "force"
      ],
      "properties": {
        "branches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "force": {
          "type": "boolean"
        }
      }
    },
    "delete_result": {
      "type": "object",
      "required": [
        "deleted",
        "failed"
      ],
      "properties": {
        "deleted": {
          "type": "array",
          "description": "Recreate a branch with: git branch NAME SHA",
          "items": {
            "type": "object",
            "required": [
              "branch",
              "sha"
            ],
            "properties": {
              "branch": {
                "type": "string"
              },
              "sha": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "branch",
              "error"
            ],
            "properties": {
              "branch": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "reset_plan": {
      "type": "object",
      "required": [
        "commit",
        "mode"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/sha"
        },
        "mode": {
          "enum": [
            "soft",
            "mixed",
            "hard"
          ]
        }
      }
    },
    "reset_result": {
      "type": "object",
      "required": [
        "commit",
        "mode",
        "previous_commit"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/sha"
        },
        "mode": {
          "enum": [
            "soft",
            "mixed",
            "hard"
          ]
        },
        "previous_commit": {
          "$ref": "#/$defs/sha",
          "description": "Reset to this commit to go back. Uncommitted changes lost by a hard reset cannot be restored this way."
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "id",
        "created_at",
        "reason",
        "scope",
        "worktree_path",
        "head",
        "branches",
        "stashes",
        "index",
        "worktree",
        "skipped_files"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "enum": [
              "branches",
              "head",
              "worktree",
              "stashes"
            ]
          }
        },
        "worktree_path": {
          "type": "string"
        },
        "head": {
          "type": "object",
          "required": [
            "branch",
            "sha"
          ],
          "properties": {
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{4,64}$"
            }
          }
        },
        "branches": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha"
          }
        },
        "stashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha"
          }
        },
        "index": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{4,64}$"
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{4,64}$"
        },
        "skipped_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Untracked files not saved because they are larger than 50 MB."
        }
      }
    },
    "undo_plan": {
      "type": "object",
      "required": [
        "snapshot",
        "branches",
        "head",
        "worktree",
        "stashes"
      ],
      "properties": {
        "snapshot": {
          "type": "string"
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "branch",
              "from",
              "to"
            ],
            "properties": {
              "branch": {
                "type": "string"
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{4,64}$"
              },
              "to": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        },
        "head": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": [
                "string",
                "null"
              ]
            },
            "to": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "worktree": {
          "type": "boolean",
          "description": "Tracked, staged and untracked files are restored."
        },
        "stashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha"
          }
        },
        "recreate_worktree": {
          "type": [
            "string",
            "null"
          ],
          "description": "Directory of a removed worktree that undo adds again before restoring it."
        }
      }
    },
    "undo_result": {
      "type": "object",
      "required": [
        "snapshot"
      ],
      "properties": {
        "snapshot": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "snapshots_result": {
      "type": "object",
      "required": [
        "snapshots"
      ],
      "properties": {
        "snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snapshot"
          }
        }
      }
    },
    "snapshot_result": {
      "type": "object",
      "required": [
        "snapshot"
      ],
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        }
      }
    },
    "gc_plan": {
      "type": "object",
      "required": [
        "older_than_days",
        "snapshots"
      ],
      "properties": {
        "older_than_days": {
          "type": "number"
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gc_result": {
      "type": "object",
      "required": [
        "deleted"
      ],
      "properties": {
        "deleted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hook_install": {
      "type": "object",
      "required": [
        "scope",
        "file",
        "command",
        "applies_to"
      ],
      "properties": {
        "scope": {
          "enum": [
            "local",
            "project",
            "user"
          ]
        },
        "file": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "applies_to": {
          "type": "string",
          "description": "Which Claude Code sessions read this file. Running sessions reload it."
        }
      }
    },
    "hook_status": {
      "type": "object",
      "required": [
        "active",
        "executable",
        "files"
      ],
      "properties": {
        "active": {
          "type": "boolean",
          "description": "The hook is in at least one settings file that applies here and the gitflash executable is on PATH."
        },
        "executable": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scope",
              "file",
              "installed",
              "command",
              "applies_to"
            ],
            "properties": {
              "scope": {
                "enum": [
                  "local",
                  "project",
                  "user"
                ]
              },
              "file": {
                "type": "string"
              },
              "installed": {
                "type": "boolean"
              },
              "command": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "applies_to": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "worktree": {
      "type": "object",
      "required": [
        "path",
        "head",
        "branch",
        "main",
        "bare",
        "locked",
        "lock_reason",
        "missing",
        "dirty",
        "ahead",
        "behind",
        "merged"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Absolute path of the worktree directory."
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "description": "null for a detached HEAD."
        },
        "main": {
          "type": "boolean"
        },
        "bare": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "lock_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "missing": {
          "type": "boolean",
          "description": "The directory no longer exists."
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Uncommitted or untracked files; null when unknown."
        },
        "ahead": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "behind": {
          "type": [
            "integer",
            "null"
          ],
