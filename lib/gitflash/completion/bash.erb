# gitflash completion for bash. Load it with: source <(gitflash completion bash)

# Adds the local branches that start with $1 (its backslashes removed), quoted for the command
# line. Branch names never go through compgen -W, which would expand them: a branch named
# $(...) would run.
_gitflash_branches() {
  local b q prefix=${1//\\/}
  while IFS= read -r b; do
    [[ $b == "$prefix"* ]] || continue
    printf -v q '%q' "$b"
    COMPREPLY+=("$q")
  done < <(<%= View::BRANCHES %>)
}

_gitflash() {
  local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]}
  # --switch=value: bash 4 and later split it into --switch, = and value (= is in
  # COMP_WORDBREAKS). bash 3.2 keeps one word, but readline still replaces only the value.
  # An = that does not follow a switch is a word of its own: = is a valid branch name.
  if [[ $cur == = && $prev == -* ]]; then
    cur=''
  elif [[ $prev == = && ${COMP_WORDS[COMP_CWORD-2]} == -* ]]; then
    prev=${COMP_WORDS[COMP_CWORD-2]}
  elif [[ $cur == --*=* ]]; then
    prev=${cur%%=*} cur=${cur#*=}
  fi
  COMPREPLY=()
  _gitflash_complete
}

# Reads cur and prev from _gitflash and fills COMPREPLY
_gitflash_complete() {
  local -a found=()
  local i w skip=0
  for ((i = 1; i < COMP_CWORD; i++)); do
    w=${COMP_WORDS[i]}
    # = after a switch: the next word is that switch's value, never an argument
    if [[ $w == = && ${COMP_WORDS[i-1]} == -* ]]; then skip=1; continue; fi
    if ((skip)); then skip=0; continue; fi
    case $w in
      <%= tree.value_switches.join('|') %>) skip=1; continue ;;
      -*) continue ;;
    esac
    found+=("$w")
  done
  local cmd=${found[0]-} n=$(( ${#found[@]} - 1 ))
<% tree.aliases.each do |from, to| -%>
  [[ $cmd == <%= from %> ]] && cmd=<%= to %>
<% end -%>
  case $cmd in <%= tree.groups.join('|') %>) if ((n > 0)); then cmd="$cmd ${found[1]}"; n=$((n - 1)); fi ;; esac
  case "$cmd $prev" in
<% value_cases.each do |pattern, value| -%>
    <%= pattern %>) <%= bash_action(value) %>; return ;;
<% end -%>
  esac
  if [[ $cur == -* ]]; then
    local words='<%= switches(tree.global_options) %>'
    case $cmd in
<% commands_with_options.each do |command| -%>
      '<%= command.path %>') words+=' <%= switches(command.options) %>' ;;
<% end -%>
    esac
    COMPREPLY=($(compgen -W "$words" -- "$cur"))
    return
  fi
  case "$cmd $n" in
    ' -1') COMPREPLY=($(compgen -W '<%= names(tree.children) %>' -- "$cur")) ;;
<% tree.groups.each do |group| -%>
    '<%= group %> 0') COMPREPLY=($(compgen -W '<%= names(tree.children(group)) %>' -- "$cur")) ;;
<% end -%>
<% argument_cases.each do |pattern, value| -%>
    <%= pattern %>) <%= bash_action(value) %> ;;
<% end -%>
  esac
}
# -o default: bash completes file names when the function offers nothing (PATH and DIR values)
complete -o default -F _gitflash gitflash
