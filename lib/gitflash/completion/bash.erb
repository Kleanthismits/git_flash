# gitflash completion for bash. Load it with: source <(gitflash completion bash)
_gitflash() {
  local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]}
  local -a found=()
  local i w skip=0
  for ((i = 1; i < COMP_CWORD; i++)); do
    w=${COMP_WORDS[i]}
    if ((skip)); then skip=0; continue; fi
    case $w in
      <%= value_switches.join('|') %>) skip=1; continue ;;
      -*) continue ;;
    esac
    found+=("$w")
  done
  local cmd=${found[0]-}
<% aliases.each do |from, to| -%>
  [[ $cmd == <%= from %> ]] && cmd=<%= to %>
<% end -%>
  case $cmd in <%= groups.join('|') %>) (( ${#found[@]} > 1 )) && cmd="$cmd ${found[1]}" ;; esac
  case "$cmd $prev" in
<% enum_options.each do |path, switch, values| -%>
    '<%= path %> <%= switch %>') COMPREPLY=($(compgen -W '<%= values.join(' ') %>' -- "$cur")); return ;;
<% end -%>
  esac
  case $prev in
    <%= value_switches.join('|') %>) return ;;
  esac
  local words=''
  case $cur in
    -*)
      words='<%= switches(global_options) %>'
      case $cmd in
<% commands_with_options.each do |command| -%>
        '<%= command.path %>') words+=' <%= switches(command.options) %>' ;;
<% end -%>
      esac
      ;;
    *)
      case $cmd in
        '') words='<%= names(children) %>' ;;
<% groups.each do |group| -%>
        '<%= group %>') words='<%= names(children(group)) %>' ;;
<% end -%>
        <%= branch_pattern %>) words="$(<%= View::BRANCHES %>)" ;;
<% commands_with_words.each do |command| -%>
        '<%= command.path %>') words='<%= command.words.join(' ') %>' ;;
<% end -%>
      esac
      ;;
  esac
  COMPREPLY=($(compgen -W "$words" -- "$cur"))
}
complete -F _gitflash gitflash
